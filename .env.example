# Path to your google-ads.yaml credentials file
# Docker container path — matches the volume mount in docker-compose.yml
GOOGLE_ADS_YAML_PATH=/app/google-ads.yaml

# Google Ads API version (v20-v23 supported by google-ads 29.2.0)
GOOGLE_ADS_API_VERSION=v20

# Default customer ID (10-digit, no dashes). Can be overridden per request.
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Secret key used to authenticate requests from your Wix site to this API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=replace-with-a-strong-random-secret

# Host/port for the FastAPI server
HOST=0.0.0.0
PORT=8000

# ── CORS — comma-separated allowed origins ────────────────────────────────────
# Production: ALLOWED_ORIGINS=https://www.ntari.org,https://ntari.org
ALLOWED_ORIGINS=https://www.ntari.org,https://ntari.org

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get this token from: Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
# Select "Docker" as the connector — Cloudflare shows the exact token to paste here
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here

# ── OAuth token generation (get_refresh_token.py only) ───────────────────────
# Only needed when running get_refresh_token.py to generate a new refresh token
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret
